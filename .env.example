# Local-development values only. Never use these credentials in production.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-for-non-local-environments
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=parking_lot
POSTGRES_USER=parking_lot
POSTGRES_PASSWORD=parking_lot
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Application-level throttling. Use an API gateway or reverse proxy as an additional production layer.
AUTH_REGISTER_THROTTLE_RATE=5/hour
AUTH_TOKEN_THROTTLE_RATE=10/minute

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Development-only persistent payment simulator: SUCCESS, FAILURE, PENDING,
# or TIMEOUT_AFTER_SUCCESS. Never treat simulator behavior as gateway certification.
SIMULATED_PAYMENT_SCENARIO=SUCCESS

